# Serve sitemap and robots with correct MIME type — must come before SPA rewrite
<IfModule mod_headers.c>
  <FilesMatch "^sitemap\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
  </FilesMatch>
</IfModule>

# Redireciona todas as rotas para index.html (necessário para React Router / SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301: www → não-www (canônico definitivo — deve vir antes do fallback SPA)
  RewriteCond %{HTTP_HOST} ^www\.sumulando\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://sumulando.com.br/$1 [R=301,L]

  # Never rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ /index.html [L]
</IfModule>
